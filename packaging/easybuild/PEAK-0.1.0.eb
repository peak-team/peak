easyblock = 'CMakeMake'

name = 'PEAK'
version = '0.1.0'

homepage = 'https://github.com/peak-team/peak'
description = 'Light-weight profiler for HPC systems'

source_urls = ['https://github.com/peak-team/peak/archive/refs/tags']
sources = ['v%(version)s.tar.gz']

builddependencies = [('CMake', '3.13')]
dependencies = [('Frida', '17.15.3')]

configopts = '-DPEAK_FETCH_DEPS=OFF -DBUILD_CUDA_PROFILE=OFF'
