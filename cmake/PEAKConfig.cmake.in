@PACKAGE_INIT@

set(PEAK_CUDA_ENABLED "@PEAK_CUDA_ENABLED@")
set(PEAK_CUDA_TOOLKIT_VERSION "@PEAK_CUDA_TOOLKIT_VERSION@")
set(PEAK_CUDA_HAS_RUNTIME_LAUNCH_EX "@PEAK_CUDA_HAS_RUNTIME_LAUNCH_EX@")
set(PEAK_CUDA_HAS_DRIVER_LAUNCH_EX "@PEAK_CUDA_HAS_DRIVER_LAUNCH_EX@")

if("@PEAK_CUDA_PACKAGE_REQUIRES_CUDATOOLKIT@")
    include(CMakeFindDependencyMacro)
    find_dependency(CUDAToolkit 11.2)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/PEAKTargets.cmake")
