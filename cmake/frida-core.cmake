# Frida Core is only needed by the independent late-attach launcher.
function(configure_frida_core output_dir)
    if(FRIDA_CORE_LIBRARIES AND FRIDA_CORE_INCLUDE_DIRS)
        message(STATUS "Using caller-provided Frida Core")
        return()
    elseif(FRIDA_CORE_LIBRARIES OR FRIDA_CORE_INCLUDE_DIRS)
        message(FATAL_ERROR "Set both FRIDA_CORE_LIBRARIES and FRIDA_CORE_INCLUDE_DIRS, or neither.")
    endif()
    if(NOT PEAK_FETCH_DEPS)
        message(FATAL_ERROR "PEAK_BUILD_ATTACH requires FRIDA_CORE_LIBRARIES/FRIDA_CORE_INCLUDE_DIRS or PEAK_FETCH_DEPS=ON.")
    endif()
    if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$")
        set(arch x86_64)
    elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$")
        set(arch arm64)
    else()
        message(FATAL_ERROR "Provide Frida Core libraries for architecture ${CMAKE_SYSTEM_PROCESSOR}.")
    endif()
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        set(platform linux)
        if(arch STREQUAL "x86_64")
            set(hash 7192919a924abf923c063762e38be4453e36e0bc7c5fbd44f2cb8730944a3158)
        else()
            set(hash 6affdec7186cb32660bcbbe526cbf1a933b29912cdbb979797ccd3bf5aec2cdd)
        endif()
    elseif(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
        set(platform macos)
        if(arch STREQUAL "x86_64")
            set(hash b259a4f196e4df6f6932c71558f5ce8bd1bbf77c17aae16e54158b1f6cae8981)
        else()
            set(hash 5fae6805fcffc82f760875483a0e59019c2500c81443fe8ca417e2e6e04b8ab8)
        endif()
    else()
        message(FATAL_ERROR "Provide FRIDA_CORE_LIBRARIES/FRIDA_CORE_INCLUDE_DIRS for this platform.")
    endif()
    set(version 17.15.3)
    set(archive "frida-core-devkit-${version}-${platform}-${arch}.tar.xz")
    file(MAKE_DIRECTORY "${output_dir}")
    if(NOT EXISTS "${output_dir}/${archive}")
        file(DOWNLOAD "https://github.com/frida/frida/releases/download/${version}/${archive}"
            "${output_dir}/${archive}" EXPECTED_HASH "SHA256=${hash}"
            TLS_VERIFY ON TIMEOUT 180 STATUS status)
        list(GET status 0 code)
        if(NOT code EQUAL 0)
            file(REMOVE "${output_dir}/${archive}")
            message(FATAL_ERROR "Frida Core download failed: ${status}")
        endif()
    endif()
    file(SHA256 "${output_dir}/${archive}" actual_hash)
    if(NOT actual_hash STREQUAL hash)
        message(FATAL_ERROR "Frida Core archive SHA256 does not match the pinned release.")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${output_dir}/${archive}"
        WORKING_DIRECTORY "${output_dir}" RESULT_VARIABLE extracted TIMEOUT 60)
    if(NOT extracted EQUAL 0)
        message(FATAL_ERROR "Could not extract Frida Core devkit.")
    endif()
    set(FRIDA_CORE_LIBRARIES "${output_dir}/libfrida-core.a" PARENT_SCOPE)
    set(FRIDA_CORE_INCLUDE_DIRS "${output_dir}" PARENT_SCOPE)
endfunction()
